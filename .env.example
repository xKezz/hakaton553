# ==========================================================
# Скопируйте в .env и заполните СВОИМИ значениями:
#
#     cp .env.example .env
#
# Файл .env не попадает в git (.gitignore) и не содержит рабочих
# токенов/паролей.
# ==========================================================

# Бот
# Токен из кабинета MAX
MAX_BOT_TOKEN=вставьте_токен_из_кабинета_MAX

# MAX user_id администратора бизнеса.
# Несколько администраторов — через запятую: 123456,789012
ADMIN_IDS=вставьте_ваш_MAX_user_id

# CSV-эмулятор программы лояльности 
# Каталог журнала эмулятора. Необязательно:
# по умолчанию data/loyalty_mock для локального запуска.
LOYALTY_MOCK_DIR=data/loyalty_mock


CAMPAIGN_DAYS=30
CAMPAIGN_FINISH_CHECK_INTERVAL=60
CAMPAIGN_SEND_DELAY_SECONDS=0.05
MAX_CSV_SIZE_BYTES=20971520
MAX_CSV_ROWS=30000


