# Файлы, которые не нужны внутри Docker-образа.
# Образ содержит только исходный код и зависимости для запуска бота.

# Служебное и локальное окружение
.git
.gitignore
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Секреты и локальные данные (монтируются томом при запуске)
.env
data/

# Документация и файлы сборки
*.md
Dockerfile
compose.yaml
.dockerignore

# Тесты запускаются локально, в образ не входят
tests/
